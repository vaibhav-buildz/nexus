# ==============================================================================
# NEXUS Environment Configuration Template
# Copy this file to .env and adjust variables as needed:
#   cp .env.example .env
# ==============================================================================

# Application Environment
PROJECT_NAME=NEXUS
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=text

# API Server
API_HOST=0.0.0.0
API_PORT=8000

# PostgreSQL Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexus_secret
POSTGRES_DB=nexus_db

# Optional direct connection string override (takes precedence if provided)
# DATABASE_URL=postgresql+asyncpg://nexus:nexus_secret@localhost:5432/nexus_db

# Database Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_ECHO=false

# Authentication & Security
JWT_SECRET_KEY=nexus-insecure-dev-secret-key-change-in-prod-minimum-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
EMAIL_VERIFICATION_EXPIRE_HOURS=24
EMAIL_SERVICE_PROVIDER=console

